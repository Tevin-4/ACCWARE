/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://accware.ug; media-src 'self' https://accware.ug; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

*.html
  Cache-Control: no-cache, must-revalidate
  Content-Type: text/html; charset=utf-8

/css/*
  Content-Type: text/css; charset=utf-8

/js/*
  Content-Type: application/javascript; charset=utf-8

/api/contact
  Cache-Control: no-store
  Content-Type: application/json
